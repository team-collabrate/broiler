{
  "name": "broiler-ops",
  "private": true,
  "version": "0.1.0",
  "description": "Operations tooling for the Honey Broilers POS: emulators, rules tests, account and data scripts. The apps live in shop/.",
  "scripts": {
    "typecheck": "npm --prefix shop run typecheck",
    "test": "npm --prefix shop test",
    "test:rules": "node scripts/test-rules.mjs",
    "emulators": "node scripts/run-emulators.mjs",
    "emulators:seed": "node scripts/seed-emulator.mjs",
    "seed": "node --env-file=shop/worker-app/.env scripts/seed-menu.mjs",
    "seed:users": "node --env-file=shop/worker-app/.env scripts/seed-users.mjs",
    "check:access": "node --env-file=shop/worker-app/.env scripts/check-access.mjs",
    "backup": "node --env-file=shop/worker-app/.env scripts/backup-data.mjs",
    "dev:emulator": "npm --prefix shop run dev:emulator"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0"
  }
}
