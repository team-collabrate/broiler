# Development against the local emulators (npm run emulators, then npm run emulators:seed). Nothing here is a secret:
# the project id starts with "demo-", which makes the emulators refuse to touch any real Firebase project.
VITE_USE_EMULATOR=1
VITE_DEV_ANON=0
VITE_SHOW_DRAFT_MENU=0
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-broiler
VITE_FIREBASE_STORAGE_BUCKET=demo-broiler.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:0
