# Copy this file to .env and fill in the real values from your Firebase
# project settings (Project settings → General → Your apps → SDK setup).
# Same Firebase project as owner-app/.env — both apps share one backend.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — free image hosting for expense receipt photos (requested
# 2026-09-05). Needs no card, unlike Firebase Storage. Get a free account at
# cloudinary.com, then: Dashboard for the Cloud Name; Settings > Upload >
# Upload presets > Add upload preset, set Signing Mode to "Unsigned", for
# the preset name. Same values as owner-app/.env — one Cloudinary account
# for both apps.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
