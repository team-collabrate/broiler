rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * True if `userId` refers to a real, active `users` doc with one of the
     * given roles. This is the strongest check achievable WITHOUT custom
     * auth claims: it doesn't prove the caller IS that user (see the
     * limitation note below), but it does prove the write is at least tied
     * to a real, currently-active staff account rather than a fabricated
     * id — closing the "any signed-in session can claim to be anyone"
     * gap for writes that carry an actor-identifying field.
     */
    function isActiveUserWithRole(userId, roles) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.active == true
        && get(/databases/$(database)/documents/users/$(userId)).data.role in roles;
    }

    // ---------------------------------------------------------------------
    // v1 LIMITATION (Phase 5 "finalize" pass — see 05_Data_Model.md §7 and
    // 06_Engineering_Plan.md §6, "PIN security is basic by design...
    // acceptable for v1, not meant for high-security multi-location use"):
    //
    // Auth is anonymous Firebase Auth per device; the actual identity
    // (worker vs owner) lives only in the `users` collection, matched
    // client-side by PIN hash. No custom auth claims are minted anywhere
    // in this stack (that would need a Cloud Function + Blaze billing —
    // flagged to the product owner, not added unprompted), so rules can
    // never fully PROVE which role the calling session belongs to.
    //
    // What CAN be done without new infra: for writes that carry a
    // client-supplied actor id (`orders.workerId`, which already exists in
    // the schema — Data Model §4), rules can at least verify that id
    // belongs to a real, active worker/owner via `isActiveUserWithRole()`
    // above. This is what `orders create` does below. A determined
    // attacker with API access could still discover a valid id (the
    // `users` collection is readable to any signed-in session, by
    // necessity — see below) and use it, but this eliminates fully
    // fabricated writes and ties every order to an identifiable, currently
    // -active account.
    //
    // What's still NOT enforceable without a schema or infra change:
    // `menu` writes have no actor-identifying field in the current Data
    // Model to check against (menu docs don't record who edited them), so
    // they remain `isSignedIn()`-gated only. Adding an `updatedBy` field
    // would let the same `isActiveUserWithRole()` pattern apply there too
    // — a scoped, no-new-infra follow-up if you want it, but it's a small
    // schema change so flagged here rather than made silently.
    //
    // `orders` update no longer has this limitation — voiding an order now
    // carries `voidedBy` and is checked the same way `create` checks
    // `workerId` (see the `orders` match block below).
    // ---------------------------------------------------------------------

    // users — PIN login must read this collection before any role is known
    // (chicken-and-egg), so any signed-in (incl. anonymous) session can
    // read. No client write path: users are provisioned via the Firebase
    // console or an admin script (Engineering Plan Phase 6), which uses
    // the Admin SDK and bypasses these rules entirely.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // menu — worker needs it for the order grid, owner needs it for
    // management, so read is any signed-in session. Write: see limitation
    // note above — not yet restrictable to role == owner without a schema
    // addition.
    match /menu/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // orders — read is any signed-in session (owner dashboard, worker
    // history). Create is hardened: workerId must reference a real, active
    // worker or owner.
    //
    // Update used to be isSignedIn()-only (see the old limitation note
    // this replaced) — that meant a worker session could, in principle,
    // edit or void any order, which is exactly backwards: voiding a
    // mistaken bill used to be owner-only for that reason. Reopened on
    // explicit product decision: a worker may now void one of their own
    // just-billed orders too (Worker app's "delete recent bill" panel),
    // with the owner-only restriction's original worry — a worker quietly
    // erasing their own mistake — addressed differently: the order stays
    // fully visible in the owner app either way, red-labeled as voided, so
    // there's no silent path, only a fast one. Bounded two ways so this
    // can't become a general "undo any bill" tool: a worker can only void
    // an order within 24 hours of billing it (createdAt-relative, not
    // trusted to "was one of the last 3" — that's a UI-only limit, not
    // something a security rule can rank across documents), while the
    // owner keeps the original unrestricted, any-time ability. Both are
    // scoped to precisely the shape voidOrder() writes: voidedBy must name
    // a real, active worker/owner, and it can only move a non-voided order
    // to voided, never anything else. Any other kind of order edit (e.g.
    // the still-unbuilt discount-correction path UpdateOrderInput exists
    // for) needs its own actor-verified shape before it can be allowed
    // here.
    //
    // Worker window widened from 30 minutes to 24 hours on explicit
    // request 2026-09-04 ("I forgot this 30mins thing... only last 3 bills
    // should be visible and can remove before end-of-the-day 3am") — the
    // product intent is "voidable through the rest of the business day",
    // but rules timestamps have no timezone-aware primitives to compute an
    // exact 3am-IST cutover safely, so a flat 24h is used instead: it's a
    // strict superset of "until the next 3am" for every possible billing
    // moment (the longest an order could legitimately need to stay
    // voidable, from just after one cutover to the next, is just under
    // 24h), so this never locks out a legitimate same-day void — it can
    // just also allow a little past exact day-end for orders billed very
    // late in their business day.
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isActiveUserWithRole(request.resource.data.workerId, ['worker', 'owner']);
      allow update: if isSignedIn() && (
        // Void — see the comment above.
        (request.resource.data.status == 'voided'
          && resource.data.status != 'voided'
          && (
            isActiveUserWithRole(request.resource.data.voidedBy, ['owner'])
            ||
            (isActiveUserWithRole(request.resource.data.voidedBy, ['worker'])
              && request.time < resource.data.createdAt + duration.value(24, 'h'))
          ))
        ||
        // markOrderSynced() — touches syncedAt and nothing else, by the
        // same worker (or owner) the order already belongs to. Narrow on
        // purpose: affectedKeys().hasOnly(['syncedAt']) means this branch
        // can never be used to smuggle in a status/total/item change
        // alongside a sync timestamp.
        (isActiveUserWithRole(resource.data.workerId, ['worker', 'owner'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncedAt']))
      );
      // Was delete-never — voiding (above) used to be the only
      // cancellation path, specifically to keep the bill-number sequence
      // and audit trail intact. Changed on explicit product decision: the
      // owner only wants the last 2 days searchable (today/yesterday — was
      // 3, narrowed 2026-09-03), older orders purged automatically (see
      // archiveAndPruneOldData in dailySummary.service.ts, called from the
      // Owner app — it saves each day's totals to `dailySummaries` before
      // deleting that day's orders, so pruning detail no longer loses the
      // history a report needs). The floor is enforced here too, not just
      // trusted to the client — createdAt has to be more than 2 days in
      // the past, so a compromised or buggy client can prune old orders
      // early, never a recent one.
      allow delete: if isSignedIn() && request.time > resource.data.createdAt + duration.value(2, 'd');
    }

    // counters — the day's bill number high-water-mark the worker app
    // hands out (see shared/src/services/billCounter.ts) — {date, value},
    // resetting each calendar day. Never money or anything else sensitive,
    // so any signed-in session may read/bump it — the worst a bad write
    // here does is a wrong number on a paper receipt, not a wrong balance.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // dailySummaries — permanent per-day totalSales/totalSpent/orderCount,
    // written once each business day falls out of the 3-day detail window
    // (see archiveAndPruneOldData). A derived reporting figure, not the
    // ledger of truth (orders/expenses are, while they still exist) — same
    // looseness as `counters` above and for the same reason: the worst a
    // bad write here does is a wrong number on a report, not a wrong
    // balance anywhere real money is tracked.
    match /dailySummaries/{date} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // expenses — money spent from the till. Same shape of protection as
    // orders: the recorded workerId has to belong to a real, active member
    // of staff, which is as far as this can be taken without custom auth
    // claims (see the limitation note above).
    //
    // Amount is checked here as well as in the UI. This collection feeds
    // spend reporting, and a negative or non-numeric amount would not fail
    // loudly — it would quietly make the books wrong.
    // customers — regulars buying on credit. Read is any signed-in session:
    // the till needs the list of who owes, the owner needs the history.
    //
    // Balance is deliberately NOT validated here. It moves by increment()
    // and the rules cannot see the resulting value, only the sentinel, so
    // there is nothing meaningful to assert — the audit trail in
    // customerPayments is what makes a wrong balance recoverable.
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.balance == 0;
      allow update: if isSignedIn();
      allow delete: if false; // settled customers stay as history, never deleted
    }

    // customerPayments — money taken against a balance. Append-only by
    // design: a receipt that can be edited or removed is not an audit trail,
    // and this is the record that settles a dispute over what was paid.
    match /customerPayments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isActiveUserWithRole(request.resource.data.workerId, ['worker', 'owner'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.customerId is string;
      allow update, delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isActiveUserWithRole(request.resource.data.workerId, ['worker', 'owner'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow update, delete: if isSignedIn();
    }
  }
}
