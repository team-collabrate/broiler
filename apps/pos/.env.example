# Firebase web app config (Firebase console > Project settings > Your apps).
# Both apps must point at the same Firebase project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional, for development only (ignored by a built app; neither belongs in production):
# Show items that are not switched on yet, to check a catalog before it goes live.
# EXPO_PUBLIC_SHOW_DRAFT_MENU=1
# Sign in anonymously on `expo start`, to see the till before the PIN accounts exist (needs the
# old open rules, so it stops working once access is locked down).
# EXPO_PUBLIC_DEV_ANON=1
