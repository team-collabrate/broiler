rules_version = '2';

// Access rules. Two accounts exist, and the sign-in email says which is which:
//   owner@broiler-pos.invalid    the owner: reads sales, sets rates, edits the menu and settings
//   counter@broiler-pos.invalid  the till: reads the menu, saves orders, nothing else
// Each account's password is its PIN (see packages/shared/src/roles.ts). Anyone else who signs up
// with the public API key has neither email, so every rule below refuses them.
//
// Rules cannot loop over a list, so an order's lines are checked at fixed positions and an order
// holds at most 20 lines (the till enforces the same limit).
service cloud.firestore {
  match /databases/{database}/documents {

    function emailIs(email) {
      return request.auth != null
        && request.auth.token.get('email', '') == email
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isOwner() { return emailIs('owner@broiler-pos.invalid'); }
    function isCounter() { return emailIs('counter@broiler-pos.invalid'); }
    function isStaff() { return isOwner() || isCounter(); }

    // The menu: the rate is per kg or per piece, whichever the item is sold by. Only the owner
    // changes it (the till asks for the owner's PIN before showing today's rates).
    match /menu/{itemId} {
      allow read: if isStaff();
      allow create, update: if isOwner()
        && request.resource.data.rateMinor is int
        && request.resource.data.rateMinor > 0;
      allow delete: if isOwner();
    }

    // Settings: how far the counter may adjust a sale's rate, and the counter's category tabs.
    match /settings/pricing {
      allow read: if isStaff();
      allow write: if isOwner()
        && request.resource.data.maxAdjustMinor is int
        && request.resource.data.maxAdjustMinor >= 0
        && request.resource.data.maxAdjustMinor <= 100000;
    }
    match /settings/categories {
      allow read: if isStaff();
      allow write: if isOwner() && request.resource.data.list is list && request.resource.data.list.size() <= 30;
    }

    function maxAdjust() {
      return exists(/databases/$(database)/documents/settings/pricing)
        ? get(/databases/$(database)/documents/settings/pricing).data.maxAdjustMinor
        : 2000;
    }

    // Each request may evaluate at most 1000 expressions, and rules cannot loop, so an order's lines are checked at
    // fixed positions and an order holds at most 5 lines (MAX_ORDER_LINES in shop/shared/src/core/sale.ts). Positions
    // an order does not have cost nothing. Per line the rules check the owner's price limit, that a line is a weight or a count, and that its total is its rate times its weight or count (or exactly the amount it was billed for).
    function validLine(l, maxAdj) {
      return l.lineTotalMinor is int && l.lineTotalMinor >= 0 && l.rateMinor > 0
        && math.abs(l.rateMinor - l.listRateMinor) <= maxAdj && l.unit in ['kg', 'piece']
        && l.grams is int && l.qty is int
        && (l.unit == 'piece' ? (l.qty >= 1 && l.grams == 0) : (l.grams >= 1 && l.qty == 0))
        && ('amountMinor' in l
          ? (l.amountMinor is int && l.amountMinor > 0 && l.lineTotalMinor == l.amountMinor)
          : (l.unit == 'piece'
            ? l.lineTotalMinor == l.rateMinor * l.qty
            : math.abs(l.lineTotalMinor - math.round(l.rateMinor * l.grams / 1000.0)) <= 1));
    }

    function linesOk(L, maxAdj) {
      return L.size() >= 1 && L.size() <= 5
        && validLine(L[0], maxAdj)
        && (L.size() < 2 || (validLine(L[1], maxAdj)
        && (L.size() < 3 || (validLine(L[2], maxAdj)
        && (L.size() < 4 || (validLine(L[3], maxAdj)
        && (L.size() < 5 || (validLine(L[4], maxAdj)))))))));
    }

    // The sum of one field over the order's lines.
    function sumOf(L, f) {
      return L.size() == 1 ? L[0][f]
        : L.size() == 2 ? L[0][f] + L[1][f]
        : L.size() == 3 ? L[0][f] + L[1][f] + L[2][f]
        : L.size() == 4 ? L[0][f] + L[1][f] + L[2][f] + L[3][f]
        : L[0][f] + L[1][f] + L[2][f] + L[3][f] + L[4][f];
    }

    function validOrder() {
      let d = request.resource.data;
      let L = d.lines;
      return d.keys().hasOnly(['orderNo', 'dayKey', 'device', 'soldAt', 'createdAt', 'staffName', 'lines', 'totalMinor', 'totalGrams', 'totalPieces', 'paymentMethod', 'cashAmountMinor', 'upiAmountMinor', 'customerId', 'customerName'])
        && d.orderNo is int && d.orderNo >= 1
        && d.dayKey is string && d.dayKey.size() == 10
        // The counter (tablet) letter that numbered the bill.
        && d.device is string && d.device.matches('^[A-Z]$')
        // Who was billing (the worker picked at the till); optional.
        && (!('staffName' in d) || (d.staffName is string && d.staffName.size() >= 1 && d.staffName.size() <= 40))
        // `createdAt` is when the server received the sale. A sale made with no internet arrives later, so `soldAt`
        // is when the tablet says it was made: never in the future (5 minutes of clock drift allowed) and never more
        // than 3 days old, so a wrong tablet clock cannot move a sale far from the truth. Keep these two limits in
        // step with MAX_SALE_AGE_MS and MAX_CLOCK_AHEAD_MS in shop/shared/src/core/outbox.ts.
        && d.createdAt == request.time
        && d.soldAt is timestamp
        && d.soldAt <= request.time + duration.value(5, 'm')
        && d.soldAt >= request.time - duration.value(3, 'd')
        && d.paymentMethod in ['cash', 'upi', 'card', 'split', 'credit']
        // A split has money on both sides and the two halves add up to the bill; no other bill has them.
        && (d.paymentMethod == 'split'
          ? (d.cashAmountMinor is int && d.upiAmountMinor is int && d.cashAmountMinor >= 1 && d.upiAmountMinor >= 1
            && d.cashAmountMinor + d.upiAmountMinor == d.totalMinor)
          : (!('cashAmountMinor' in d) && !('upiAmountMinor' in d)))
        // A credit bill names who owes it; no other bill does.
        && (d.paymentMethod == 'credit'
          ? (d.customerId is string && d.customerId.size() > 0
            && d.customerName is string && d.customerName.size() > 0 && d.customerName.size() <= 120)
          : (!('customerId' in d) && !('customerName' in d)))
        && L is list
        && linesOk(L, maxAdjust())
        && d.totalMinor is int && d.totalMinor == sumOf(L, 'lineTotalMinor')
        && d.totalGrams is int && d.totalGrams >= 0
        && d.totalPieces is int && d.totalPieces >= 0;
    }

    // Orders are append-only, with two exceptions that never touch the money fields:
    //  - a bill can be DELETED (voided): it stays, marked `status: 'voided'` with who and when, and every total
    //    leaves it out. The owner may void any bill; the counter only one made in the last 24 hours (the till's
    //    screen offers its last 3). A credit bill's customer balance must be given back in the same transaction
    //    (see the customers rule). Once a day's totals are saved (dailySummaries) its bills can no longer change.
    //  - a bill older than 3 days may be removed by the owner, but only after that day's totals are saved.
    // Only the owner can list and read sales. The till may fetch a single order it saved in the last 24 hours (by its
    // id): to retry a sale after a lost response (it finds the first copy instead of saving a second one) and to delete
    // one of its own recent bills, which needs the bill and its customer read inside the transaction.
    match /orders/{orderId} {
      function voidedNow() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['status', 'voidedAt', 'voidedBy'])
          && d.status == 'voided'
          && resource.data.get('status', '') != 'voided'
          && d.voidedAt == request.time
          && d.voidedBy == request.auth.uid
          && !exists(/databases/$(database)/documents/dailySummaries/$(resource.data.dayKey))
          && (resource.data.paymentMethod != 'credit'
            || getAfter(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.get('lastVoidedOrderId', '') == orderId);
      }
      allow list: if isOwner();
      allow get: if isOwner()
        || (isCounter() && (resource == null || resource.data.createdAt > request.time - duration.value(24, 'h')));
      allow create: if isStaff() && validOrder();
      allow update: if voidedNow()
        && (isOwner() || (isCounter() && resource.data.createdAt > request.time - duration.value(24, 'h')));
      allow delete: if isOwner()
        && resource.data.get('soldAt', resource.data.createdAt) < request.time - duration.value(3, 'd')
        && exists(/databases/$(database)/documents/dailySummaries/$(resource.data.dayKey));
    }

    // Credit (கடன்). A customer's balance only moves together with the document that explains the move,
    // written in the same transaction: a credit order raises it by exactly that order's total, a payment
    // lowers it by exactly that receipt's amount, and a voided credit bill lowers it by exactly that bill's total. `createdAt == request.time` proves the order or receipt is
    // from this very transaction, not an old one being replayed. The name never changes, and a customer is
    // never deleted (a settled one is history). The counter reads the list to pick who owes.
    function orderAfter(id) { return getAfter(/databases/$(database)/documents/orders/$(id)).data; }
    function paymentAfter(id) { return getAfter(/databases/$(database)/documents/customerPayments/$(id)).data; }

    match /customers/{customerId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['name', 'nameKey', 'balanceMinor', 'lastOrderId', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.lastOrderId is string
        && orderAfter(request.resource.data.lastOrderId).paymentMethod == 'credit'
        && orderAfter(request.resource.data.lastOrderId).customerId == customerId
        && orderAfter(request.resource.data.lastOrderId).createdAt == request.time
        && request.resource.data.balanceMinor == orderAfter(request.resource.data.lastOrderId).totalMinor;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceMinor', 'lastOrderId', 'lastPaymentId', 'lastVoidedOrderId', 'updatedAt'])
        && request.resource.data.balanceMinor is int
        && request.resource.data.balanceMinor >= 0
        && (
          (request.resource.data.get('lastOrderId', '') != resource.data.get('lastOrderId', '')
            && orderAfter(request.resource.data.lastOrderId).paymentMethod == 'credit'
            && orderAfter(request.resource.data.lastOrderId).customerId == customerId
            && orderAfter(request.resource.data.lastOrderId).createdAt == request.time
            && request.resource.data.balanceMinor == resource.data.balanceMinor + orderAfter(request.resource.data.lastOrderId).totalMinor)
          ||
          (request.resource.data.get('lastPaymentId', '') != resource.data.get('lastPaymentId', '')
            && paymentAfter(request.resource.data.lastPaymentId).customerId == customerId
            && paymentAfter(request.resource.data.lastPaymentId).createdAt == request.time
            && request.resource.data.balanceMinor == resource.data.balanceMinor - paymentAfter(request.resource.data.lastPaymentId).amountMinor)
          ||
          (request.resource.data.get('lastVoidedOrderId', '') != resource.data.get('lastVoidedOrderId', '')
            && orderAfter(request.resource.data.lastVoidedOrderId).paymentMethod == 'credit'
            && orderAfter(request.resource.data.lastVoidedOrderId).customerId == customerId
            && orderAfter(request.resource.data.lastVoidedOrderId).status == 'voided'
            && orderAfter(request.resource.data.lastVoidedOrderId).voidedAt == request.time
            && request.resource.data.balanceMinor == resource.data.balanceMinor - orderAfter(request.resource.data.lastVoidedOrderId).totalMinor)
        );
      allow delete: if false;
    }

    // Receipts for money taken against a balance. Append-only: one that can be edited is not an audit
    // trail. Only the owner reads them back; the counter writes them.
    match /customerPayments/{paymentId} {
      allow read: if isOwner();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['customerId', 'customerName', 'amountMinor', 'method', 'dayKey', 'createdAt'])
        && request.resource.data.customerId is string
        && request.resource.data.customerName is string && request.resource.data.customerName.size() <= 120
        && request.resource.data.amountMinor is int && request.resource.data.amountMinor > 0
        && request.resource.data.method in ['cash', 'upi']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // One document per day, written by the owner's app when a day falls out of the 4 days of full bills (document id
    // "<day>", for example "2026-10-21"): the day's totals, so weeks and months can be shown without reading every
    // bill, and so the bills can then be removed. Written once and never changed: a summary that could be edited
    // would let history be rewritten.
    match /dailySummaries/{day} {
      allow read: if isOwner();
      allow create: if isOwner()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['dayKey', 'orderCount', 'totalMinor', 'cashMinor', 'upiMinor', 'creditMinor', 'totalGrams', 'totalPieces', 'items', 'categories', 'createdAt'])
        && request.resource.data.keys().hasAll(['dayKey', 'orderCount', 'totalMinor', 'cashMinor', 'upiMinor', 'creditMinor', 'totalGrams', 'totalPieces', 'items', 'categories', 'createdAt'])
        && request.resource.data.dayKey == day
        && request.resource.data.orderCount is int && request.resource.data.orderCount >= 0
        && request.resource.data.totalMinor is int && request.resource.data.totalMinor >= 0
        && request.resource.data.cashMinor is int && request.resource.data.cashMinor >= 0
        && request.resource.data.upiMinor is int && request.resource.data.upiMinor >= 0
        && request.resource.data.creditMinor is int && request.resource.data.creditMinor >= 0
        && request.resource.data.totalGrams is int && request.resource.data.totalGrams >= 0
        && request.resource.data.totalPieces is int && request.resource.data.totalPieces >= 0
        && request.resource.data.items is map && request.resource.data.categories is map
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // The server's note of how far each counter got on a day, document id "<day>_<letter>" (for example
    // "2026-10-21_A"), written in the same batch as each order. A tablet whose storage was lost reads it to carry on
    // from the right bill number. It is only a hint: the numbers themselves are made on the tablet.
    match /counters/{counterId} {
      allow read: if isStaff();
      allow write: if isStaff()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next >= 1;
    }
  }
}
